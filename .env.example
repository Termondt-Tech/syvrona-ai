# Syvrona environment. Copy to .env and fill in. Never commit .env.
# Every variable the app reads is listed here with no value; the app refuses to start
# without DATABASE_URL and SECRET_KEY (app/config.py). Compose passes this file to the
# web container; `flask` CLI reads .flaskenv; app.py calls load_dotenv(). Use .env only.

# --- Flask ---
FLASK_ENV=development                  # development | production
FLASK_CONFIG=DevelopmentConfig         # DevelopmentConfig | TestingConfig | ProductionConfig
FLASK_APP=app.py
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000
LOG_LEVEL=INFO

# --- Database (compose uses the MYSQL_* for the mysql service; the app uses DATABASE_URL) ---
MYSQL_ROOT_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=syvrona
DATABASE_URL=mysql+pymysql://USER:PASSWORD@mysql/syvrona?charset=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800

# --- Security ---
SECRET_KEY=                            # python -c "import secrets; print(secrets.token_hex(32))"
SECURITY_PASSWORD_SALT=                # used by itsdangerous for confirm/reset tokens
WTF_CSRF_ENABLED=true
WTF_CSRF_TIME_LIMIT=86400

# --- Model providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=                        # google-genai also honours GOOGLE_API_KEY

# --- Stripe ---
STRIPE_API_KEY=                        # sk_test_... locally; never a live key outside production
STRIPE_WEBHOOK_SECRET=                 # whsec_...
STRIPE_PRICE_ID_PRO_MONTHLY=           # price_...
STRIPE_PRICE_ID_PRO_YEARLY=            # price_...

# --- Feature flags ---
FREE_TRIAL_ENABLED=false
FREE_TRIAL_DAYS=7

# --- Mailgun ---
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=Syvrona Support <mailgun@example.com>

# --- hCaptcha ---
HCAPTCHA_ENABLED=false
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# --- Rate limiting and quotas (JSON) ---
RATELIMIT_STORAGE_URI=redis://redis:6379/0
RATE_LIMIT_TIERS={"free": "5 per minute;100 per day", "pro": "60 per minute;3000 per day"}
TOKEN_QUOTAS={"free": 50000, "pro": 1000000}

# --- Gunicorn (production) ---
GUNICORN_WORKERS=5
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=100
GUNICORN_MAX_REQUESTS_JITTER=20
GUNICORN_LOGLEVEL=info
